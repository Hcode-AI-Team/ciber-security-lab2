{
  "name": "combio-cve-watch",
  "version": "1.0.0",
  "private": true,
  "description": "Agente LangGraph que vigia CVEs nas dependências do monorepo e abre issue urgente para alta/crítica",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cve:watch": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.6.0",
    "@langchain/core": "^1.3.4",
    "@langchain/langgraph": "^1.6.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.0",
    "typescript": "~5.9.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/index.ts"
    ]
  }
}
